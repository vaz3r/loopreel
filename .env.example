# =============================================================================
# Loopreel Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# All secrets are loaded by docker-compose and injected into containers at runtime.
# Never commit .env to version control.

# -----------------------------------------------------------------------------
# Infrastructure
# -----------------------------------------------------------------------------
# PostgreSQL connection string (used by all workers and the API)
DATABASE_URL="postgresql://loopreel:loopreel@100.99.147.104:5432/loopreel"

# Redis connection string (used by BullMQ job queues)
REDIS_URL="redis://100.99.147.104:6379"

# -----------------------------------------------------------------------------
# LLM Provider
# -----------------------------------------------------------------------------
# The primary LLM provider and model used for all content generation (structuring, summarisation).
# Supports OpenRouter, Google AI Studio, or any OpenAI-compatible endpoint.

# OpenRouter API key (required if LLM_PROVIDER=openrouter)
LLM_API_KEY="sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Base URL for the LLM API (OpenRouter default, or your own endpoint)
LLM_BASE_URL="https://openrouter.ai/api/v1"

# Google AI Studio API key (required if LLM_PROVIDER=google)
LLM_GOOGLE_API_KEY="your-google-ai-studio-api-key"

# Model identifier (provider-specific, e.g. "google/gemini-2.5-flash-lite" for OpenRouter)
LLM_MODEL="gemini-3.1-flash-lite"

# Request timeout in milliseconds (default: 120000 = 2 minutes)
LLM_TIMEOUT=120000

# Maximum number of retries on transient LLM errors (default: 3)
LLM_MAX_RETRIES=3

# LLM provider selection: "openrouter" or "google"
# When "google", LLM_GOOGLE_API_KEY is used directly with Google's Generative AI API.
# When "openrouter", LLM_API_KEY is used with OpenRouter's OpenAI-compatible endpoint.
LLM_PROVIDER="google"

# Enable multi-phase slide generation pipeline (recommended).
# When true, uses a 3-phase pipeline: Extract → Configure → Generate.
# When false, uses a single monolithic prompt (legacy, lower quality).
LLM_MULTI_PHASE=true

# -----------------------------------------------------------------------------
# Background Images (Unsplash)
# -----------------------------------------------------------------------------
# Used by the background-fetch worker to search and download free stock photos.
UNSPLASH_ACCESS_KEY="your-unsplash-access-key"
UNSPLASH_SECRET_KEY="your-unsplash-secret-key"

# -----------------------------------------------------------------------------
# Storage (Cloudflare R2)
# -----------------------------------------------------------------------------
# Cloudflare R2 is used for storing rendered slide images and downloadable assets.
# R2 is S3-compatible — you can swap in any S3 provider by also setting R2_ENDPOINT.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="loopreel"

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# API server port (exposed by the api container)
API_PORT=3000

# Log level: "debug", "info", "warn", "error" (default: "info")
LOG_LEVEL="info"

# Public-facing API URL (used by worker-render to fetch job data)
# When running locally, use localhost. In Docker, workers talk to http://api:3000 internally.
API_URL="http://localhost:3000"

# Enable debug logging pipeline (default: false).
# When true, workers write intermediate LLM outputs and extracted text to ./debug/{jobId}/
# Files produced:
#   00-extracted.txt      — raw scraped text (worker-ingest)
#   02-phase1-brief.xml   — summarised brief from LLM (worker-structure)
#   03-phase2-config.xml  — slide configuration from LLM (worker-structure)
#   04-phase3-slides.xml  — raw slide generation output (worker-structure)
#   05-paginated.json     — final slide payload before render (worker-structure)
#   06-rendered.json      — render completion summary (worker-render)
DEBUG_LOG=true

# -----------------------------------------------------------------------------
# Whisper (worker-transcribe)
# -----------------------------------------------------------------------------
# URL for the faster-whisper ASR service (used for YouTube video transcription).
# Default points to the faster-whisper container in docker-compose.
WHISPER_URL="http://localhost:8000"

# -----------------------------------------------------------------------------
# Browser Pool (worker-render)
# -----------------------------------------------------------------------------
# Number of Playwright browser tabs in the rendering pool.
# Higher values = more parallel renders, but more memory usage.
# Each tab consumes ~200-500MB depending on slide complexity.
PLAYWRIGHT_POOL_SIZE=20

# Port for the render worker's Prometheus metrics sidecar.
METRICS_PORT=8004
